# ============================================================
#  iStoreOS RK3588 BDY-G98 基础 .config
#  硬件档案（来自 ophub/model_database.conf r123）：
#    SoC      : RK3588
#    RAM      : 16GB
#    存储     : 2x NVMe + SATA
#    网口     : 2x 2.5GbE (RK3588 GMAC) + 8x 1GbE (YT9215S 交换芯片)
#    FDT      : rk3588-bdy-g98.dtb
#    U-Boot   : u-boot.itb + idbloader.img
# ============================================================

# ---- Target ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_generic=y

# ---- 固件格式 ----
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_PAD=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---- NVMe x2 ----
CONFIG_PACKAGE_kmod-pcie=y
CONFIG_PACKAGE_kmod-pcie-device=y
CONFIG_PACKAGE_kmod-pcie-host=y
CONFIG_PACKAGE_kmod-pcie-msi=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-nvme-core=y
CONFIG_PACKAGE_kmod-pcie-rc=y

# ---- SATA ----
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-ata-ahci-platform=y

# ---- 2x 2.5GbE (RK3588 内置 GMAC / RTL8125 类) ----
CONFIG_PACKAGE_kmod-net-phy=y
CONFIG_PACKAGE_kmod-mdio-bus-mmd=y
CONFIG_PACKAGE_r8169=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# ---- 8x 1GbE via YT9215S 交换芯片 ----
# YT9215S 在 OpenWrt 里走 swconfig / DSA，按你内核实际名字选
CONFIG_PACKAGE_kmod-swconfig=y
CONFIG_PACKAGE_kmod-swphy=y
CONFIG_PACKAGE_kmod-mdio-gpio=y
# CONFIG_PACKAGE_kmod-yt9215=y   # 若你内核已带，取消注释

# ---- USB / 存储 ----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb3=y

# ---- PWM 风扇 ----
# pwm-fan 驱动已在内核 hwmon 里，通常不需要额外包；
# 若用 sysfs 手动调速，下面这个提供温度读取：
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_lm-sensors=y

# ---- 常用系统 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_sysfsutils=y

# ---- 中文 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
